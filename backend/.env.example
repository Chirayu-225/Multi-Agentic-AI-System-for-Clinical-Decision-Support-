# Copy this file to backend/.env and fill in real values.
# `cp backend/.env.example backend/.env`  (macOS/Linux)
# `copy backend\.env.example backend\.env`  (Windows)

# ── Gemini ────────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/  → Get API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Auth ──────────────────────────────────────────────────────────────────
# Named accounts sign in with POST /auth/login and receive a short-lived JWT.
# JWT_SECRET signs those tokens: at least 32 characters, never committed.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random per-process secret is used (everyone is logged out on every restart).
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60

# Shared service key (X-API-Key header; WebSocket ?api_key=). Role "service": can upload
# and read, can NEVER approve reports or read the audit log. Set ALLOW_API_KEY_AUTH=false
# to turn this path off entirely once everyone uses named accounts.
API_KEY=
ALLOW_API_KEY_AUTH=true

# First-run accounts, created at startup if the username does not exist yet. Passwords need
# 10+ characters. Remove these lines from .env after the first successful start.
BOOTSTRAP_CLINICIAN_USERNAME=
BOOTSTRAP_CLINICIAN_PASSWORD=
BOOTSTRAP_CLINICIAN_DISPLAY_NAME=
# Optional patient account, bound to exactly one patient_id:
BOOTSTRAP_PATIENT_USERNAME=
BOOTSTRAP_PATIENT_PASSWORD=
BOOTSTRAP_PATIENT_PATIENT_ID=

# ── Clinical safety gate ───────────────────────────────────────────────────
# true (default): every new report is "pending_review" and hidden from patients until a
# clinician approves it. false auto-approves (demo use only).
REQUIRE_CLINICIAN_REVIEW=true

# ── Audit log ─────────────────────────────────────────────────────────────
# Hash-chained, PHI-free audit trail (table audit_events). Keep enabled.
AUDIT_ENABLED=true

# ── OCR (scanned reports / photos) ────────────────────────────────────────
# Local EasyOCR only - images are never sent to a hosted vision model. auto|true|false
OCR_GPU=auto

# ── Database ──────────────────────────────────────────────────────────────
# Local dev default (no Docker): SQLite, no setup needed.
DATABASE_URL=sqlite:///./medsight.db
# Docker Compose overrides this to Postgres automatically — see docker-compose.yml.
# If you're running Postgres yourself instead of via Docker Compose:
# DATABASE_URL=postgresql://medsight:CHANGE_ME@localhost:5432/medsight

# ── Docker Compose only — Postgres container credentials ───────────────────
POSTGRES_DB=medsight
POSTGRES_USER=medsight
POSTGRES_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:80

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
