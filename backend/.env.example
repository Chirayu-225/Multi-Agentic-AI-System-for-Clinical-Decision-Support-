# ── Model provider ─────────────────────────────────────────────────────
# groq or gemini. If left empty: groq when GROQ_API_KEY is set, otherwise gemini.
LLM_PROVIDER=groq
# Groq free tier (https://console.groq.com). Used when the provider is groq.
GROQ_API_KEY=
# One pinned model for every agent. llama-3.3-70b-versatile: ~1,000 requests/day and 12,000 tokens/minute free.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional, off by default: a smaller model tried only when the main one is rate limited or down
# (for example llama-3.1-8b-instant, ~14,400 requests/day). Its answers differ, so use it knowingly.
GROQ_FALLBACK_MODEL=
# Overall request timeout for either provider (GEMINI_TIMEOUT_SECONDS still works).
LLM_TIMEOUT_SECONDS=90

# Copy this file to backend/.env and fill in real values.
# `cp backend/.env.example backend/.env`  (macOS/Linux)
# `copy backend\.env.example backend\.env`  (Windows)

# ── Gemini ────────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/  → Get API Key
GEMINI_API_KEY=
# One pinned model for every agent (see src/llm.py). gemini-2.5-flash only works for
# keys that have used it before; new keys need a current model such as gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
# Used only when GEMINI_MODEL is still overloaded (503 "high demand") after retries.
# Leave empty to disable. Each run records which model actually answered.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Per-request timeout. Without one, a stalled call hangs the upload indefinitely.
GEMINI_TIMEOUT_SECONDS=90

# ── Auth ──────────────────────────────────────────────────────────────────
# Named accounts sign in with POST /auth/login and receive a short-lived JWT.
# JWT_SECRET signs those tokens: at least 32 characters, never committed.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60

# First-run accounts, created at startup if the username does not exist yet. Passwords need
# 10+ characters. Remove these lines from .env after the first successful start.
BOOTSTRAP_CLINICIAN_USERNAME=
BOOTSTRAP_CLINICIAN_PASSWORD=
BOOTSTRAP_CLINICIAN_DISPLAY_NAME=
# Optional patient account, bound to exactly one patient_id:
BOOTSTRAP_PATIENT_USERNAME=
BOOTSTRAP_PATIENT_PASSWORD=
BOOTSTRAP_PATIENT_PATIENT_ID=

# ── Clinical safety gate ───────────────────────────────────────────────────
# true (default): every new report is "pending_review" and hidden from patients until a
# clinician approves it. false auto-approves (demo use only).
REQUIRE_CLINICIAN_REVIEW=true

# ── Optional features (off by default) ────────────────────────────────────
# Slope-based forecasts are illustrative linear projections; PubMed adds literature
# links. Neither is part of the core clinician workflow.
ENABLE_FORECASTING=false
ENABLE_PUBMED=false

# ── Audit log ─────────────────────────────────────────────────────────────
AUDIT_ENABLED=true

# ── OCR (scanned reports / photos) ────────────────────────────────────────
# Local EasyOCR only - images are never sent to a hosted model. auto|true|false
OCR_GPU=auto

# ── Database ──────────────────────────────────────────────────────────────
# Local dev default: SQLite. Docker Compose overrides this to Postgres.
DATABASE_URL=sqlite:///./medsight.db

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200

# ── Upload job queue ──────────────────────────────────────────────────────
# Uploads are queued in the database and analysed by background workers (src/jobs/).
# JOB_WORKERS: reports analysed at once per process (each one makes several model calls).
#   0 = this process only accepts uploads and another process runs the jobs.
JOB_WORKERS=2
# A failed attempt is retried with exponential backoff (15s, 30s, ...) up to this many attempts.
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=15
# A running job must renew its lease; if the process dies, another worker takes the job over
# once the lease (seconds) runs out.
JOB_LEASE_SECONDS=60
# New uploads get 503 + Retry-After when this many jobs are already queued or running.
JOB_QUEUE_MAX=200
# Finished jobs are kept this long so the UI can still poll their status.
JOB_RETENTION_HOURS=24
# Where uploaded files wait until their job ends (holds PHI). Must survive restarts and be
# shared by every worker. Default: a "medsight-spool" folder in the system temp directory.
# UPLOAD_SPOOL_DIR=

# ── Model protection (free-tier friendly) ──────────────────────────────────
# Requests per minute this process may send to Gemini (0 = no limit). Set it just under your
# key's per-minute quota; workers share it.
LLM_RPM=10
LLM_BURST=5
# After this many consecutive provider failures the model is treated as down for the cooldown,
# and calls fail instantly instead of each report waiting out retries.
LLM_BREAKER_FAILURES=5
LLM_BREAKER_COOLDOWN_SECONDS=60
# Hard cap on model calls for one report (a runaway loop costs a bounded amount of quota).
LLM_MAX_CALLS_PER_REPORT=12
# How long a job may wait for the model to come back before finishing with degraded output.
JOB_DEFER_MAX_SECONDS=3600
# Notional prices (USD per million tokens) used only to report what a paid tier would cost.
LLM_PRICE_INPUT_PER_M=0.30
LLM_PRICE_OUTPUT_PER_M=2.50

# ── History-store outbox ──────────────────────────────────────────────────
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_POLL_SECONDS=5

# ── Evaluation gate (python -m eval.frozen_gate) ───────────────────────────
GATE_MAX_CALLS=40
GATE_DAILY_CALLS=100
GATE_TOLERANCE_CASES=1

# ── Metrics ───────────────────────────────────────────────────────────────
# GET /metrics (Prometheus format) is disabled unless a token is set. Not exposed by nginx.
METRICS_TOKEN=

# ── Logging ───────────────────────────────────────────────────────────────
# Every line carries the request id and job id: [req=... job=...]
LOG_LEVEL=INFO
